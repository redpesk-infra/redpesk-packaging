#!/usr/bin/make -f
# -*- makefile -*-
# Uncomment this to turn on verbose mode.
export DH_VERBOSE=1
export VERSION=$(shell grep -E "^Version" ../*dsc | cut -d':' -f2)
%: 
	dh $@
override_dh_auto_install:
	mkdir -p /usr/src/packages/BUILD/debian/tmp/usr/share/afb-ui-devtools/binder
	cp -r `ls -Idebian` /usr/src/packages/BUILD/debian/tmp/usr/share/afb-ui-devtools/binder/

override_dh_auto_test:
